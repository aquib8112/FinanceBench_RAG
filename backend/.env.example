# backend/.env.example
# Query embeddings through the Gemini Developer API (use a free-tier project for free calls).
GOOGLE_API_KEY=your-google-api-key-here
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=your-langchain-project-name

# Decomposition, context judging and answer generation through OpenRouter.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Uses LANGCHAIN_API_KEY and LANGCHAIN_PROJECT above for LangSmith tracing.
LANGCHAIN_TRACING_V2=true
# The shared model wrapper forwards OpenRouter charges to LangSmith.
